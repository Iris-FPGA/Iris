#!/usr/bin/env bash
set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/efinity-env"

PROJ_DIR="${IRIS_PROJ_DIR:-$SCRIPT_DIR/../iris_ws}"
cd "$PROJ_DIR"

echo "==> map";              efx_run --prj iris_ws -f map
echo "==> interface";        efx_run --prj iris_ws -f interface
echo "==> 修复 sdc 时钟周期"
sed -i 's|<USER_PERIOD> -name CLK_25M|40.000 -name CLK_25M|; s|<USER_PERIOD> -name gpio_clk_27m|37.037 -name gpio_clk_27m|' outflow/iris_ws.pt.sdc
# core_clk stays at its true 10.000 ns (100 MHz).  The TinyML-integrated
# design used to close at only a few ps of margin before the arbiter got
# output pipeline slices; plain pnr is used again (effort=5/TIMING_3
# measured worse than default on this design).
cat constraints/video_domains.sdc >> outflow/iris_ws.pt.sdc
# Define input clocks before any generated PHY/UART delay uses them.
python3 - <<'PY'
from pathlib import Path
p = Path('outflow/iris_ws.pt.sdc')
lines = p.read_text().splitlines(keepends=True)
p.write_text(''.join(x for x in lines if x.startswith('create_clock ')) +
             ''.join(x for x in lines if not x.startswith('create_clock ')))
PY
# iris_ws.xml references this project-root filename. Without this copy PNR
# silently ignores the generated clocks and uses a default 1 ns constraint.
cp outflow/iris_ws.pt.sdc iris_ws.pt.sdc
echo "==> pnr";              efx_run --prj iris_ws -f pnr
python3 "$SCRIPT_DIR/check-iris-timing" outflow/iris_ws.timing.rpt
echo "==> pgm(生成bit/hex)"; efx_run --prj iris_ws -f pgm
echo "完成：outflow/iris_ws.bit 与 iris_ws.hex"

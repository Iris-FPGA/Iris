#!/usr/bin/env bash
set -eo pipefail
export PYTHONUNBUFFERED=1
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/efinity-env"
PACKAGE_DIR="$(realpath "${1:?Usage: .script/sync-style-switch <build-style-switch output directory>}")"

# Bind the programmer input to both timing-checked images and the exact payload
# used by the OCR loader. Stop before touching JTAG if anything has changed.
python3 - "$PACKAGE_DIR" "$SCRIPT_DIR" <<'PY'
import hashlib,json,subprocess,sys
from pathlib import Path
p=Path(sys.argv[1]);m=json.loads((p/'manifest.json').read_text())
def digest(f):return hashlib.sha256(f.read_bytes()).hexdigest()
if m.get('hdmi_acceptance')=='failed':
    raise SystemExit('This package failed physical HDMI validation; use a repaired build')
if digest(p/'style-switch.hex')!=m['combined_sha256']:
    raise SystemExit('Combined Flash image differs from manifest')
if m.get('requires_flash_cold_boot') is not True:
    raise SystemExit('Package predates the active Flash boot requirement; rebuild it')
if digest(p/'firmware/tinyml_style.bin')!=m['rain_firmware_sha256']:
    raise SystemExit('Rain firmware differs from loader-bound payload')
if digest(p/'stream-firmware/stream_style-live.bin')!=m['stream_firmware_sha256']:
    raise SystemExit('One Last Kiss firmware differs from preserved payload')
for name,project in m['projects'].items():
    d=Path(project)/'outflow'
    if digest(d/'iris_ws.bit')!=m['bit_sha256'][name]:
        raise SystemExit('FPGA image differs from manifest: '+name)
    subprocess.run([sys.executable,str(Path(sys.argv[2])/'check-iris-timing'),str(d/'iris_ws.timing.rpt')],check=True)
PY
cd "$PACKAGE_DIR/stream/iris_ws"
efx_run --prj iris_ws -f program --pgm_opts mode=jtag \
    --pgm_opts "source=$EFINITY_HOME/pgm/fli/titanium/u10660A79.bit"
efx_run --prj iris_ws -f program --pgm_opts mode=jtag_bridge \
    --pgm_opts "source=$PACKAGE_DIR/style-switch.hex" | tee "$PACKAGE_DIR/program-flash.log"
if ! rg -q 'Flash verify successful' "$PACKAGE_DIR/program-flash.log"; then
    echo 'Flash readback verification was not confirmed' >&2
    exit 1
fi
echo 'Flash readback verified. Power-cycle the board to boot from Flash before testing KEY3.'

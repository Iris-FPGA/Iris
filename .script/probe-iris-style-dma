#!/usr/bin/env python3
"""Known 64KiB RGBA fixture: CPU store/read, CI read/copy/read, one-second hold.
Load FPGA SRAM freshly before each invocation and start official OpenOCD.
Overwrites source/destination windows; do not run alongside a live interpreter.
No software image inference or JTAG pixel readback is used as DMA evidence.
"""
import argparse, hashlib, json, re, socket, subprocess, time
from pathlib import Path
root=Path(__file__).resolve().parents[1]
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--src',type=lambda x:int(x,0),default=0x00700000)
p.add_argument('--dst',type=lambda x:int(x,0),default=0x03000000)
p.add_argument('--serial-ddr',action='store_true')
p.add_argument('--capture-first',action='store_true',help='insert one real camera capture before known-pattern checks')
p.add_argument('--captures',type=int,default=1,help='number of sequential captures before fixture checks, with --capture-first')
p.add_argument('--output',type=Path,required=True)
p.add_argument('--bit-file',type=Path,default=root/'iris_ws/outflow/iris_ws.bit',help='identity of the already programmed FPGA bitstream')
a=p.parse_args()
if not 1<=a.captures<=128 or (a.captures!=1 and not a.capture_first):
    p.error('--captures requires --capture-first and a count between 1 and 128')
if any(x%16 or x<0x00700000 or x+65536>0x10000000 for x in [a.src,a.dst]):
    p.error('windows must be aligned DDR addresses at or above 7MiB')
if abs(a.src-a.dst)<65536:p.error('source and destination overlap')
def sha(f):return hashlib.sha256(f.read_bytes()).hexdigest()
elf=root/'firmware/tinyml_style/build/style_dma_probe.elf'
bp=root/'iris_ws/embedded_sw/SapphireSoc'
src=root/'firmware/tinyml_style/probe/style_dma.c'
ld=root/'firmware/tinyml_style/probe/bram.ld'
start=root/'firmware/tinyml_style/probe/start.S'
cmd=['/home/noir/Applications/riscv-none-elf/bin/riscv-none-elf-gcc','-Os',
     '-march=rv32im_zicsr_zifencei','-mabi=ilp32','-msmall-data-limit=0','-nostdlib',
     f'-DIRIS_DMA_PROBE_SRC=0x{a.src:x}u',f'-DIRIS_DMA_PROBE_DST=0x{a.dst:x}u',
     f'-DIRIS_DMA_PROBE_CAPTURE={a.captures if a.capture_first else 0}',
     '-I'+str(bp/'bsp/efinix/EfxSapphireSoc/include'),
     '-I'+str(bp/'software/standalone/driver'),'-T'+str(ld),str(start),str(src),'-o',str(elf)]
subprocess.run(cmd,check=True)
r={'scope':__doc__,'src':hex(a.src),'dst':hex(a.dst),'serial_ddr':a.serial_ddr,'capture_first':a.capture_first,'requested_captures':a.captures if a.capture_first else 0,
   'compile_command':cmd,'elf_sha256':sha(elf),'source_sha256':sha(src),
   'bit_sha256':sha(a.bit_file)}
with socket.create_connection(('localhost',6666),timeout=30) as c:
    def tcl(z):
        c.sendall(z.encode()+b'\x1a');b=b''
        while b'\x1a' not in b:
            chunk=c.recv(65536)
            if not chunk:raise RuntimeError('OpenOCD disconnected')
            b+=chunk
        return b.decode(errors='replace').rstrip('\x1a')
    tcl('halt');tcl('reset halt');tcl('mww 0xf8100030 '+str(int(a.serial_ddr)))
    r['load']=tcl('load_image {'+str(elf)+'}')
    if 'downloaded' not in r['load']:raise RuntimeError('ELF load not confirmed')
    tcl('resume 0xf9000000');end=time.monotonic()+12
    while time.monotonic()<end:
        time.sleep(.5);raw=tcl('mdw 0xf9000e00 1')
        if any(x in raw for x in ('600d0001','bad0000','dead0001')):break
    tcl('halt');r['raw']=tcl('mdw 0xf9000e00 32')
    r['registers']={x:tcl('reg '+x+' force') for x in ['pc','mcause','mepc','mtval']}
    r['arbiter']=tcl('mdw 0xf8110000 19');r['words']=[]
    for line in r['raw'].splitlines():
        if re.match(r'^0xf9000e[0-9a-f]+:',line):
            r['words'] += [int(x,16) for x in line.split(':',1)[1].split()]
w=r['words'];r['fixture_passed']=len(w)==32 and w[0]==0x600d0001 and w[23]==0x49520101 and w[24]==0
r['passed']=r['fixture_passed']
if len(w)==32:
    r['cpu_source_mismatches']=w[24];r['dma_source_mismatches']=w[1]
    r['dma_copy_source_dummy_bad']=w[15];r['dma_destination_mismatches']=w[9]
    r['dma_destination_retention_mismatches']=w[16]
    if a.capture_first:
        r['capture']={'status':w[18],'source_dummy_bad':w[19],'bus_dummy_bad':w[20],'captures':w[21],'first_64KiB_read_dummy_bad':w[22]}
        r['camera_read_ok']=(w[18]&7)==2 and w[19]==0 and w[20]==0 and w[21]==a.captures and w[22]==0
        if a.captures>1:
            ticks=(w[8]<<32)|w[17]
            r['capture_completion_span_ticks']=ticks
            r['clint_hz']=100000000
            r['observed_capture_hz']=(a.captures-1)*r['clint_hz']/ticks if ticks else None
        r['passed']=r['passed'] and r['camera_read_ok']
a.output.parent.mkdir(parents=True,exist_ok=True)
a.output.write_text(json.dumps(r,indent=2)+'\n');print(json.dumps(r,indent=2),flush=True)
raise SystemExit(0 if r['passed'] else 1)

#!/usr/bin/env python3
"""Build and run the Iris DDR diagnostic through an existing OpenOCD server.

Requires the SRAM image with 16 KiB OCR and the native-line CPU adapter.
Does not program FPGA SRAM or Flash. Leaves the CPU halted after the test.
"""
import argparse
import hashlib
import json
from pathlib import Path
import re
import socket
import subprocess
import time

root = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--base', type=lambda x: int(x, 0), default=0x00f00000)
parser.add_argument('--execute-ddr', action='store_true')
parser.add_argument('--compiler', default='/home/noir/Applications/riscv-none-elf/bin/riscv-none-elf-gcc')
parser.add_argument('--port', type=int, default=6666)
parser.add_argument('--wait', type=float, default=20)
parser.add_argument('--output', type=Path, required=True)
args = parser.parse_args()
if args.base % 16 or not (0x00900000 <= args.base <= 0x0fff0000):
    parser.error('probe base must be 16-byte aligned in the reserved compute window above 9 MiB')
if not 4 <= args.wait <= 60:
    parser.error('--wait must be between 4 and 60 seconds')
probe = root/'firmware/tinyml_style/probe'
build = root/'firmware/tinyml_style/build'
build.mkdir(exist_ok=True)
elf = build/('ddr_code_probe.elf' if args.execute_ddr else 'ddr_probe.elf')
bsp = root/'iris_ws/embedded_sw/SapphireSoc'
cmd = [args.compiler, '-Os', '-march=rv32im_zicsr_zifencei', '-mabi=ilp32',
       '-msmall-data-limit=0', '-nostdlib', f'-DIRIS_PROBE_BASE=0x{args.base:x}',
       '-I'+str(bsp/'bsp/efinix/EfxSapphireSoc/include'),
       '-I'+str(bsp/'software/standalone/driver'),
       '-T'+str(probe/('ddr_code.ld' if args.execute_ddr else 'bram.ld')),
       str(probe/'start.S'), str(probe/'main.c'), '-o', str(elf)]
subprocess.run(cmd, check=True)
def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()
with socket.create_connection(('localhost', args.port), timeout=30) as connection:
    def tcl(command):
        connection.sendall(command.encode()+b'\x1a')
        response = bytearray()
        while b'\x1a' not in response:
            chunk = connection.recv(65536)
            if not chunk:
                raise RuntimeError('OpenOCD closed the connection')
            response.extend(chunk)
        return response.decode(errors='replace').rstrip('\x1a')
    tcl('halt')
    load = tcl('load_image '+str(elf))
    if 'downloaded' not in load:
        raise RuntimeError('ELF load was not confirmed: '+load)
    tcl('resume 0xf9000000')
    time.sleep(args.wait)
    tcl('halt')
    raw = tcl('mdw 0xf9000e00 20')
    words = []
    for line in raw.splitlines():
        if re.match(r'^0xf9000e[0-9a-f]+:', line):
            words.extend(int(w, 16) for w in line.split(':', 1)[1].split())
    registers = {name: tcl('reg '+name+' force') for name in ('pc','mcause','mepc','mtval')}
report = {'base':hex(args.base), 'code_in_ddr':args.execute_ddr,
          'compile_command':cmd, 'elf_sha256':sha(elf), 'load':load,
          'words':words, 'raw':raw, 'registers':registers,
          'bit_sha256':sha(root/'iris_ws/outflow/iris_ws.bit'),
          'source_sha256':{str(f.relative_to(root)):sha(f) for f in
              [probe/'main.c',probe/'start.S',probe/'bram.ld',probe/'ddr_code.ld',
               root/'iris_ws/src/ddr/axi_atype_bridge.v',
               root/'iris_ws/src/ddr/axi_ddr_arbiter.v',
               root/'iris_ws/src/cnn/tinyml_subsystem.v']}}
errors = [1,5,9,10,11,12,13,14,16,17,18,19]
report['passed'] = (len(words)==20 and words[0]==0x600d0001 and
                    words[15]==0x12345679 and all(words[i]==0 for i in errors))
args.output.parent.mkdir(parents=True, exist_ok=True)
args.output.write_text(json.dumps(report, indent=2)+'\n')
print(raw, flush=True)
print('PASS' if report['passed'] else 'FAIL or incomplete; inspect report', args.output)
raise SystemExit(0 if report['passed'] else 1)
